# Server
PORT=4000
NODE_ENV=development

# MySQL server (one server hosts the master DB + every tenant DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=scholr

# Master (control-plane) database: holds the tenant registry + super-admins
DB_MASTER_NAME=scholr_master
# Each tenant gets its own database named <prefix><code>, e.g. scholr_t_greenwood
TENANT_DB_PREFIX=scholr_t_

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Seed super admin (created by db:seed)
SEED_SUPERADMIN_EMAIL=superadmin@scholr.app
SEED_SUPERADMIN_PASSWORD=admin1234
